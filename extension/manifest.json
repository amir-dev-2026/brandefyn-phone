{
  "manifest_version": 3,
  "name": "Brandefyn Phone panel for GHL",
  "version": "2.0.0",
  "description": "Adds a Call, Text and Voicemail panel to GoHighLevel contact pages that works through the Brandefyn Phone (Twilio).",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*/v2/location/*"],
      "js": ["ghl.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://amir-dev-2026.github.io/brandefyn-phone/*"],
      "js": ["phone.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
