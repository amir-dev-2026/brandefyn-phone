{
  "manifest_version": 3,
  "name": "Brandefyn Phone – Call button for GHL",
  "version": "1.2.0",
  "description": "Adds Call and Text buttons to GoHighLevel contact pages that dials through the Brandefyn Phone (Twilio).",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*/v2/location/*"],
      "js": ["ghl.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://amir-dev-2026.github.io/brandefyn-phone/*"],
      "js": ["phone.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
